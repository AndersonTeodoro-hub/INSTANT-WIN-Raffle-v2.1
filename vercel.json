{
  "rewrites": [
    {
      "source": "/events/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|WhatsApp|SkypeUriPreview|Pinterestbot|redditbot|Embedly|Iframely|Bluesky|Mastodon|vkShare).*"
        }
      ],
      "missing": [{ "type": "query", "key": "app" }],
      "destination": "/api/og/event?id=:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/bridge/v2/cron/process.ts": { "maxDuration": 300 },
    "api/bridge/v2/cron/maintenance.ts": { "maxDuration": 300 },
    "api/bridge/v2/entry/start.ts": { "maxDuration": 148 },
    "api/bridge/v2/entry/resume.ts": { "maxDuration": 68 },
    "api/bridge/v2/creator/campaign/start.ts": { "maxDuration": 100 },
    "api/bridge/v2/creator/campaign/submit.ts": { "maxDuration": 270 },
    "api/bridge/v2/campaign/identity/save.ts": { "maxDuration": 106 },
    "api/bridge/v2/account/register.ts": { "maxDuration": 106 },
    "api/bridge/v2/account/migrate.ts": { "maxDuration": 108 },
    "api/bridge/v2/account/relay.ts": { "maxDuration": 280 }
  },
  "crons": [
    { "path": "/api/bridge/v2/cron/process", "schedule": "* * * * *" },
    { "path": "/api/bridge/v2/cron/maintenance", "schedule": "0 * * * *" }
  ]
}
