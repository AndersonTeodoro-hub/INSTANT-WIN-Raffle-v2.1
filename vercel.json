{
  "redirects": [
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "instntwin.com" }], "destination": "https://keptra.io/:path", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "www.instntwin.com" }], "destination": "https://keptra.io/:path", "permanent": true },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "www.keptra.io" }], "destination": "https://keptra.io/:path", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/events/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|WhatsApp|SkypeUriPreview|Pinterestbot|redditbot|Embedly|Iframely|Bluesky|Mastodon|vkShare).*"
        }
      ],
      "missing": [{ "type": "query", "key": "app" }],
      "destination": "/api/og/event?id=:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/bridge/v2/cron/process.ts": { "maxDuration": 300 },
    "api/bridge/v2/cron/maintenance.ts": { "maxDuration": 300 },
    "api/bridge/v2/entry/start.ts": { "maxDuration": 156 },
    "api/bridge/v2/entry/resume.ts": { "maxDuration": 110 },
    "api/bridge/v2/creator/campaign/start.ts": { "maxDuration": 214 },
    "api/bridge/v2/creator/campaign/status.ts": { "maxDuration": 132 },
    "api/bridge/v2/creator/campaign/submit.ts": { "maxDuration": 300 },
    "api/bridge/v2/campaign/identity/save.ts": { "maxDuration": 116 },
    "api/bridge/v2/account/register.ts": { "maxDuration": 166 },
    "api/bridge/v2/account/migrate.ts": { "maxDuration": 150 },
    "api/bridge/v2/account/recovery.ts": { "maxDuration": 182 },
    "api/bridge/v2/account/relay.ts": { "maxDuration": 300 },
    "api/bridge/v2/order/address.ts": { "maxDuration": 110 },
    "api/bridge/v2/order/evidence.ts": { "maxDuration": 116 },
    "api/bridge/v2/store/tracking.ts": { "maxDuration": 158 },
    "api/bridge/v2/arbiter/evidence.ts": { "maxDuration": 66 },
    "api/bridge/v2/account/status.ts": { "maxDuration": 188 },
    "api/bridge/v2/account/vouchers.ts": { "maxDuration": 142 },
    "api/bridge/v2/store/description.ts": { "maxDuration": 92 },
    "api/bridge/v2/privacy/erase.ts": { "maxDuration": 282 }
  },
  "crons": [
    { "path": "/api/bridge/v2/cron/process", "schedule": "* * * * *" },
    { "path": "/api/bridge/v2/cron/maintenance", "schedule": "0 * * * *" }
  ]
}
